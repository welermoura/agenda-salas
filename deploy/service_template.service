[Unit]
Description=Backend Service for __HOSTNAME__
# Garante que a rede e os discos estejam prontos antes de iniciar
After=network-online.target local-fs.target
Wants=network-online.target
Requires=local-fs.target

[Service]
User=seu_usuario
Group=www-data
WorkingDirectory=/opt/__HOSTNAME__/backend
ExecStart=/opt/__HOSTNAME__/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
StandardOutput=append:/var/log/__HOSTNAME__/backend.log
StandardError=append:/var/log/__HOSTNAME__/backend_error.log

[Install]
WantedBy=multi-user.target
