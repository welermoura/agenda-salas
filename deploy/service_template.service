[Unit]
Description=Backend Service for __HOSTNAME__
After=network.target

[Service]
User=seu_usuario
Group=www-data
WorkingDirectory=/opt/__HOSTNAME__
ExecStart=/opt/__HOSTNAME__/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --app-dir /opt/__HOSTNAME__/backend
Restart=always
RestartSec=3
StandardOutput=append:/var/log/__HOSTNAME__/backend.log
StandardError=append:/var/log/__HOSTNAME__/backend_error.log

[Install]
WantedBy=multi-user.target
