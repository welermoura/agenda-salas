[Unit]
Description=Backend Service for __HOSTNAME__
# Garante que a rede e os discos estejam prontos antes de iniciar
After=network-online.target local-fs.target
Wants=network-online.target
Requires=local-fs.target

[Service]
User=seu_usuario
Group=www-data
WorkingDirectory=/opt/__HOSTNAME__
# Adiciona um atraso de 20 segundos para aguardar a estabilização dos discos
ExecStartPre=/bin/sleep 20
ExecStart=/opt/__HOSTNAME__/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --app-dir backend
Restart=always
RestartSec=3
StandardOutput=append:/var/log/__HOSTNAME__/backend.log
StandardError=append:/var/log/__HOSTNAME__/backend_error.log

[Install]
WantedBy=multi-user.target
