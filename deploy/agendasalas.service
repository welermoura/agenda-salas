# Arquivo de Serviço Systemd para o Backend AgendaSalas
# /etc/systemd/system/agendasalas.service

[Unit]
Description=AgendaSalas Backend Service (FastAPI/Uvicorn)
# Garante que o serviço inicie apenas depois da rede estar disponível
After=network.target

[Service]
# IMPORTANTE: Substitua 'seu_usuario' pelo nome de usuário que irá rodar a aplicação.
# Pode ser o mesmo usuário que roda o Apache ou um usuário dedicado.
# É uma boa prática de segurança não rodar como 'root'.
User=seu_usuario
Group=www-data

# O caminho absoluto para o diretório raiz do projeto em produção
WorkingDirectory=/opt/agendasalas

# Comando para iniciar o servidor Uvicorn usando o Python do ambiente virtual (venv)
# Isso garante que todas as dependências do projeto sejam encontradas corretamente.
ExecStart=/opt/agendasalas/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --app-dir /opt/agendasalas/backend

# Garante que o Uvicorn tenha um temp-dir para trabalhar sem problemas de permissão
Environment="TMPDIR=/opt/agendasalas/tmp"

# Política de reinicialização para garantir que o serviço esteja sempre de pé
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
